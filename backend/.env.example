# --- Supabase / Postgres ---
# Get this from Supabase dashboard -> Project Settings -> Database -> Connection String (URI)
# Example: postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./local_dev.db

# For fast local testing without Supabase, you can instead use:
# DATABASE_URL=sqlite:///./local_dev.db

# --- LLM keys (pick whichever your team uses) ---
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_PROVIDER=gemini

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
