# Copy to .env for local dev against a real backend (leave both unset/false
# to use vite.config.js's proxy to http://localhost:8000).
# VITE_API_BASE_URL=

# Set true to run the UI with zero backend, fully on mockData.js.
VITE_USE_MOCK=false

# Which customer to load in the demo (matches seed_data.py's demo customer).
VITE_DEMO_CUSTOMER_ID=1
